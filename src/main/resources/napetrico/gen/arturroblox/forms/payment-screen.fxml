<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javafx.geometry.Insets?>
<AnchorPane maxHeight="Infinity" maxWidth="Infinity" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="napetrico.gen.arturroblox.controllers.PaymentScreenController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
   </padding>
   <children>
      <!-- TableView fills all space above the bottom panel -->
      <TableView fx:id="shoppingCartTable" AnchorPane.bottomAnchor="138.0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
         <columns>
            <TableColumn fx:id="item" text="Item" />
            <TableColumn fx:id="quantity" text="Quantity" />
            <TableColumn fx:id="total" text="Total" />
         </columns>
      </TableView>

      <!-- Bottom panel pinned to the bottom -->
      <VBox spacing="20.0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="8.0" AnchorPane.rightAnchor="8.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="25.0">
               <children>
                  <Label text="Total">
                     <font><Font size="14.0" /></font>
                  </Label>
                  <Label fx:id="totalLabel" text="0,00 €">
                     <font><Font size="18.0" /></font>
                  </Label>
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="25.0">
               <children>
                  <Label text="Payment Method">
                     <font><Font size="14.0" /></font>
                  </Label>
                  <ComboBox fx:id="paymentMethod" prefWidth="175.0" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="25.0">
               <children>
                  <Button fx:id="confirm" mnemonicParsing="false" text="Confirm" />
                  <Button fx:id="cancel" mnemonicParsing="false" text="Cancel" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
