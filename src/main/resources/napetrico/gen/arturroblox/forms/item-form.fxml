<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="300.0"
      prefWidth="350.0" spacing="10.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="napetrico.gen.arturroblox.controllers.ItemFormController">
    <VBox prefHeight="200.0" prefWidth="100.0">
        <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="15.0">
            <padding>
                <Insets left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Label text="Descrição">
                <font>
                    <Font size="18.0"/>
                </font>
            </Label>
            <TextField fx:id="description" promptText="Insira uma descrição"/>
        </HBox>
        <Label fx:id="descriptionError" prefHeight="17.0" prefWidth="280.0" styleClass="error-label"/>
        <padding>
            <Insets bottom="5.0" left="5.0"/>
        </padding>
    </VBox>
    <VBox prefHeight="200.0" prefWidth="100.0">
        <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="15.0">
            <padding>
                <Insets left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Label text="Preço Unitário">
                <font>
                    <Font size="18.0"/>
                </font>
            </Label>
            <TextField fx:id="unitPrice" prefHeight="25.0" prefWidth="159.0"
                       promptText="Insira um número válido"/>
        </HBox>
        <Label fx:id="unitPriceError" prefHeight="17.0" prefWidth="280.0" styleClass="error-label"/>
        <padding>
            <Insets bottom="5.0" left="5.0"/>
        </padding>
    </VBox>
    <VBox prefHeight="200.0" prefWidth="100.0">
        <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="15.0">
            <padding>
                <Insets left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Label text="Categoria">
                <font>
                    <Font size="18.0"/>
                </font>
            </Label>
            <Button fx:id="categoryButton" text="Selecione uma categoria"/>
        </HBox>
        <padding>
            <Insets bottom="5.0" left="5.0"/>
        </padding>
    </VBox>
    <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="100.0" spacing="40.0">
        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
        </padding>
        <Button mnemonicParsing="false" onAction="#onCancelClick" styleClass="button, button-secondary" text="Cancelar">
            <font>
                <Font size="14.0"/>
            </font>
        </Button>
        <Button mnemonicParsing="false" onAction="#onConfirmClick" styleClass="button, button-success" text="Confirmar">
            <font>
                <Font size="14.0"/>
            </font>
        </Button>
    </HBox>
</VBox>
