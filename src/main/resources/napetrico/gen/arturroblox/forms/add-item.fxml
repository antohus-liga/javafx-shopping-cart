<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="200.0"
      prefWidth="300.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="napetrico.gen.arturroblox.controllers.AddItemController">
    <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="15.0">
        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
        </padding>
        <Label text="Description">
            <font>
                <Font size="18.0"/>
            </font>
        </Label>
        <TextField promptText="Enter a description"/>
    </HBox>
    <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="15.0">
        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
        </padding>
        <Label text="Unit Price">
            <font>
                <Font size="18.0"/>
            </font>
        </Label>
        <TextField prefHeight="25.0" prefWidth="159.0" promptText="Enter a numeric unit price"/>
    </HBox>
    <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="40.0">
        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
        </padding>
        <Button mnemonicParsing="false" text="Cancel" onAction="#onCancelClick" styleClass="button, button-secondary">
            <font>
                <Font size="14.0"/>
            </font>
        </Button>
        <Button mnemonicParsing="false" text="Confirm" styleClass="button, button-success">
            <font>
                <Font size="14.0"/>
            </font>
        </Button>
    </HBox>
</VBox>
