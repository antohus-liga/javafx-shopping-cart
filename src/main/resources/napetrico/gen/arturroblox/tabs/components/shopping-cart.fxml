<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="napetrico.gen.arturroblox.controllers.ShoppingCartController"
            maxWidth="Infinity" maxHeight="Infinity">
    <TableView fx:id="cart"
               AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="50"
               AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <columns>
            <TableColumn fx:id="add" text="+"/>
            <TableColumn fx:id="sub" text="-"/>
            <TableColumn fx:id="item" text="Artigo"/>
            <TableColumn fx:id="quantity" text="Quantidade"/>
            <TableColumn fx:id="total" text="Total"/>
            <TableColumn fx:id="remove" text="✕"/>
        </columns>
    </TableView>
    <HBox spacing="30.0"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">
        <Button fx:id="clear" text="Limpar" onAction="#onClearClick" styleClass="button, button-danger">
            <font>
                <Font size="14.0"/>
            </font>
        </Button>
        <Button fx:id="purchase" text="Pagamento" onAction="#onPurchaseClick" styleClass="button, button-success">
            <font>
                <Font size="14.0"/>
            </font>
        </Button>
        <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
        </padding>
    </HBox>
</AnchorPane>
