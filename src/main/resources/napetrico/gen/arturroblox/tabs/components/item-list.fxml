<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<AnchorPane maxHeight="Infinity" maxWidth="Infinity" prefWidth="310.0" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="napetrico.gen.arturroblox.controllers.ItemListController">
    <TableView fx:id="itemsTable" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
               AnchorPane.topAnchor="0">
        <columns>
            <TableColumn fx:id="remove" text="✕"/>
            <TableColumn fx:id="description" text="Descrição"/>
            <TableColumn fx:id="unitPrice" text="Preço Unitário"/>
            <TableColumn fx:id="add" text="+"/>
        </columns>
    </TableView>
    <HBox spacing="30.0"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">
        <Button fx:id="createItem" text="Criar artigo" onAction="#onCreateItemClick" styleClass="button, button-success">
            <font>
                <Font size="14.0"/>
            </font>
        </Button>
        <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
        </padding>
    </HBox>
</AnchorPane>
