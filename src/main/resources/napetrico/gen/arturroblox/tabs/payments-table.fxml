<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<?import javafx.geometry.Insets?>
<AnchorPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="napetrico.gen.arturroblox.controllers.PaymentsTableController"
            maxWidth="Infinity" maxHeight="Infinity">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
    <!-- HBox fills the entire AnchorPane -->
    <HBox spacing="8.0"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- Left table: takes 40% of space -->
        <TableView fx:id="paymentsTable" HBox.hgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity">
            <columns>
                <TableColumn fx:id="paymentTotal" text="Total"/>
                <TableColumn fx:id="date" text="Date"/>
            </columns>
        </TableView>

        <!-- Right table: takes 60% of space -->
        <TableView fx:id="paymentDetailsTable" HBox.hgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity">
            <columns>
                <TableColumn fx:id="quantity" text="Quantity"/>
                <TableColumn fx:id="item" text="Item"/>
                <TableColumn fx:id="itemTotal" text="Total"/>
            </columns>
        </TableView>
    </HBox>
</AnchorPane>
